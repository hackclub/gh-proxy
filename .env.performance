# High Performance Configuration for 500+ RPS
# Copy these settings to your production .env file

# Database Connection Pool
# Budget: replicas x DB_MAX_CONNS (x2 during a rolling deploy) must stay under
# Postgres max_connections minus superuser_reserved_connections (100 - 3 = 97
# on our db1), with headroom for migrations/psql. Extra requests queue in the
# pool instead of failing; the server logs "db pool: N acquires waited" when
# that happens.
DB_MAX_CONNS=30               # Maximum database connections per instance
DB_MAX_IDLE_CONNS=5           # Minimum connections kept open (pgxpool MinConns)
DB_CONN_MAX_LIFETIME=1800     # 30 minutes connection lifetime

# Cache Settings (Improve Hit Rate)
MAX_CACHE_TIME=900            # 15 minutes (was 300)
MAX_CACHE_SIZE_MB=1000        # 1GB cache (was 100MB)

# Request Limits (Keep Original)
MAX_PROXY_BODY_BYTES=1048576  # 1MB (original limit)

# Standard Settings (Keep as-is)
DATABASE_URL=your_production_database_url
BASE_URL=https://your-domain.com
ADMIN_USER=your_admin_user
ADMIN_PASS=your_secure_admin_password
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret

# Performance Notes:
# - More DB connections is not faster past a point: Postgres throughput peaks
#   around a few connections per CPU core, and going over max_connections fails
#   requests outright
# - Larger cache improves hit rates (less GitHub API calls)  
# - Smaller body limits reduce memory pressure
# - With 119 donated tokens, GitHub rate limits shouldn't be an issue
